---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CoffeeList from '@/components/CoffeeList.astro'
import coffeesIndex from '@/cache/coffees/index.json'
import type { CoffeeBag } from '@/types/coffee'

export async function getStaticPaths({ paginate }) {
  const allCoffees = coffeesIndex as CoffeeBag[]
  return paginate(allCoffees, { pageSize: 8 })
}

const { page } = Astro.props
---

<BaseLayout title="Coffees">
     <h1 class="mainTitle">The List</h1>
    <section class="coffeeList container grid">
       <CoffeeList bags={page.data}/>
    </section>


  <nav class="pager">
    {page.url.prev && <a href={page.url.prev}>Newer</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next && <a href={page.url.next}>Older</a>}
  </nav>
</BaseLayout>
